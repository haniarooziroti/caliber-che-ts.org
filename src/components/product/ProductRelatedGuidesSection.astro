---
import type { ForumPost } from '../../data/forum';
import SectionHeader from '../SectionHeader.astro';
import { Button } from '@/components/starwind/button';
import Icon from '../icons/Icon.astro';
import { ROUTES } from '../../utils/path';

interface Props {
  posts: ForumPost[];
  productName: string;
}

const { posts, productName } = Astro.props;
---

{
  posts.length > 0 && (
    <section class="border-t border-border bg-muted/20 py-16 md:py-24" aria-labelledby="related-forum-heading">
      <div class="mx-auto max-w-6xl px-5">
        <SectionHeader
          eyebrow="Forum"
          title={`Threads that pair with ${productName}`}
          desc="Community discussions on loaders, ESP layouts, aim tuning, and patch talk that match this product."
          titleId="related-forum-heading"
        />

        <ul class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <li class="rounded-2xl border border-border/60 bg-card p-5">
              <p class="text-xs uppercase tracking-wide text-primary">{post.category}</p>
              <a class="mt-2 block font-semibold text-foreground hover:text-primary" href={`/forum/${post.slug}/`}>
                {post.title}
              </a>
              <p class="mt-2 text-sm text-muted-foreground">{post.excerpt}</p>
              <p class="mt-3 text-xs text-muted-foreground">{post.commentsCount} replies · u/{post.author}</p>
            </li>
          ))}
        </ul>

        <div class="mt-12 flex justify-start lg:justify-center">
          <Button as="a" href={ROUTES.forum} variant="outline" class="rounded-full">
            Browse all forum threads
            <Icon name="arrowRight" size={17} />
          </Button>
        </div>
      </div>
    </section>
  )
}
