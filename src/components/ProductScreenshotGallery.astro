---
import type { ProductSlide } from '../data/products';
import ResponsiveImage from './ResponsiveImage.astro';
import { DEFAULT_IMAGE_WIDTHS, THUMB_IMAGE_WIDTHS, defaultWebpSrc, responsiveSrcSet } from '../utils/responsiveImage';
import { Badge } from '@/components/starwind/badge';

interface Props {
  images: ProductSlide[];
  id?: string;
}

const { images, id = 'product-screenshots' } = Astro.props;
const hasThumbs = images.length > 1;
const first = images[0];
---

<div
  class:list={['product-gallery', !hasThumbs && 'product-gallery--single']}
  id={id}
  data-product-gallery
>
  <div class="product-gallery__stage">
    <div class="product-gallery__main cursor-zoom-in">
      {
        first && (
          <ResponsiveImage
            src={first.src}
            alt={first.alt}
            width={960}
            height={540}
            loading="eager"
            fetchPriority="high"
            sizes="(min-width: 1200px) 46vw, (min-width: 768px) 58vw, 100vw"
            class="product-gallery__image w-full"
            data-master-src={first.src}
          />
        )
      }
    </div>
    <Badge
      tone="neutral"
      appearance="frosted"
      size="sm"
      class="pointer-events-none absolute bottom-3 left-3 shadow-sm"
    >
      Screenshot from the build
    </Badge>
  </div>

  {
    hasThumbs && (
      <div class="product-gallery__thumbs" role="tablist" aria-label="Product screenshots">
        {images.map((img, i) => (
          <button
            type="button"
            class:list={['product-gallery__thumb', i === 0 && 'is-active']}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-label={`Screenshot ${i + 1}`}
            data-product-gallery-thumb
            data-index={i}
            data-src={defaultWebpSrc(img.src, DEFAULT_IMAGE_WIDTHS)}
            data-srcset={responsiveSrcSet(img.src, DEFAULT_IMAGE_WIDTHS)}
            data-master-src={img.src}
            data-alt={img.alt}
          >
            <ResponsiveImage
              src={img.src}
              alt={`Smaller preview of product screenshot: ${img.alt}`}
              width={320}
              height={180}
              widths={THUMB_IMAGE_WIDTHS}
              loading="lazy"
              sizes="148px"
              class="size-full object-cover"
            />
          </button>
        ))}
      </div>
    )
  }
</div>

<script>
  const initProductGalleries = () => {
    document.querySelectorAll('[data-product-gallery]').forEach((root) => {
      if (root.hasAttribute('data-gallery-bound')) return;
      root.setAttribute('data-gallery-bound', '');

      const mainHost = root.querySelector('.product-gallery__main');
      const main = mainHost?.querySelector<HTMLImageElement>('img.product-gallery__image');
      const webpSource = mainHost?.querySelector<HTMLSourceElement>('picture source[type="image/webp"]');
      const thumbs = root.querySelectorAll<HTMLButtonElement>('[data-product-gallery-thumb]');
      if (!main || !thumbs.length) return;

      thumbs.forEach((thumb) => {
        thumb.addEventListener('click', () => {
          const alt = thumb.getAttribute('data-alt');
          const src = thumb.getAttribute('data-src');
          const srcset = thumb.getAttribute('data-srcset');
          const master = thumb.getAttribute('data-master-src');
          if (srcset) {
            if (webpSource) webpSource.srcset = srcset;
            main.srcset = srcset;
          } else {
            webpSource?.removeAttribute('srcset');
            main.removeAttribute('srcset');
          }
          if (src) main.src = src;
          if (master) main.setAttribute('data-master-src', master);
          if (alt) main.alt = alt;
          thumbs.forEach((t) => {
            const active = t === thumb;
            t.classList.toggle('is-active', active);
            t.setAttribute('aria-selected', active ? 'true' : 'false');
          });
        });
      });
    });
  };

  initProductGalleries();
  document.addEventListener('astro:after-swap', initProductGalleries);
</script>
