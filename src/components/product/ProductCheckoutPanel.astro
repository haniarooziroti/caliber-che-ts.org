---
import type { ProductPage } from '../../data/products';
import { checkoutPath } from '../../config/checkout';
import Icon from '../icons/Icon.astro';
import ProductIconWell from './ProductIconWell.astro';

interface Props {
  product: ProductPage;
}

const { product } = Astro.props;
const features = product.fullFeatures.slice(0, 6);
const checkoutHref = product.buyUrl;
const dmaCheckoutHref = checkoutPath('cloud-dma');
const spooferCheckoutHref = checkoutPath('hwid-spoofer');
const externalRel = 'noopener noreferrer';
---

<aside class="product-checkout text-left lg:sticky lg:top-24" aria-labelledby={`checkout-${product.slug}`}>
  <div class="overflow-hidden rounded-2xl border border-primary/35 bg-card shadow-md ring-1 ring-primary/15">
    <div class="card-title-band flex items-center gap-3 px-4 py-3 text-left sm:px-5 sm:py-3.5">
      <ProductIconWell name="acqPackage" iconSize={20} class="bg-primary/15" />
      <div class="min-w-0 text-left">
        <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Product features</p>
        <h2 id={`checkout-${product.slug}`} class="text-base font-semibold leading-snug">Explore what's included</h2>
      </div>
    </div>

    <div class="product-checkout__body flex flex-col gap-4 px-4 py-4 sm:px-5 sm:py-4">
      <ul class="product-checkout__features space-y-2">
        {
          features.map((feature) => (
            <li class="flex items-center gap-3">
              <span
                class="flex size-5 shrink-0 items-center justify-center rounded-full bg-primary/15 text-primary"
                aria-hidden="true"
              >
                <Icon name="check" size={13} />
              </span>
              <span class="min-w-0 text-sm font-medium leading-snug text-foreground">{feature}</span>
            </li>
          ))
        }
      </ul>

      <div class="product-checkout__actions space-y-3.5">
        <a
          href={checkoutHref}
          rel={externalRel}
          class="inline-flex h-11 w-full items-center justify-center gap-2 rounded-xl bg-primary px-4 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90 sm:h-12"
        >
          Proceed to Checkout →
          <Icon name="arrowRight" size={17} />
        </a>
        <p class="text-center text-xs leading-relaxed text-muted-foreground">
          Pricing and available plans are shown at the merchant checkout.
        </p>
        {
          product.slug !== 'cloud-dma' && product.slug !== 'hwid-spoofer' && (
            <div class="product-checkout__addons space-y-2 border-t border-border pt-3">
              <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Add-ons</p>
              <a
                href={dmaCheckoutHref}
                rel={externalRel}
                class="inline-flex h-11 w-full items-center justify-between gap-3 rounded-xl border border-border bg-background px-3.5 text-sm font-medium text-foreground transition-colors hover:border-primary/50"
              >
                <span class="truncate">Cloud DMA checkout</span>
                <Icon name="arrowRight" size={16} class="shrink-0" />
              </a>
              <a
                href={spooferCheckoutHref}
                rel={externalRel}
                class="inline-flex h-11 w-full items-center justify-between gap-3 rounded-xl border border-border bg-background px-3.5 text-sm font-medium text-foreground transition-colors hover:border-primary/50"
              >
                <span class="truncate">HWID spoofer checkout</span>
                <Icon name="arrowRight" size={16} class="shrink-0" />
              </a>
            </div>
          )
        }
      </div>
    </div>
  </div>
</aside>
