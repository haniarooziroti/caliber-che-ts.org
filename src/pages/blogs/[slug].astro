---
import '../../styles/blog-pages.css';
import '../../styles/blog-sidebar.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BlogCard from '../../components/BlogCard.astro';
import BlogSidebar from '../../components/BlogSidebar.astro';
import BlogArticleBody from '../../components/BlogArticleBody.astro';
import BlogFaqSection from '../../components/BlogFaqSection.astro';
import BlogPostTopBar from '../../components/BlogPostTopBar.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import Icon from '../../components/icons/Icon.astro';
import { Button } from '@/components/starwind/button';
import { getAllBlogSlugs, getBlogArticle, getRelatedBlogArticles, toBlogCardPost } from '../../data/blogs/index';
import { getRelatedBlogPostsFull } from '../../data/blog';
import { ROUTES } from '../../utils/path';
import { articleSchema, breadcrumbSchema, parseBlogDate } from '../../utils/schema';
import { canonicalUrl } from '../../config/seo';
import { t } from '../../i18n';

export function getStaticPaths() {
  return getAllBlogSlugs().map((slug) => ({ params: { slug } }));
}

const article = getBlogArticle(Astro.params.slug!);
if (!article) return Astro.redirect('/blogs/');

const path = `/blogs/${article.slug}/`;
const breadcrumbs = [
  { name: t.pages.crumbs.home, path: '/' },
  { name: t.pages.crumbs.blogs, path: '/blogs/' },
  { name: article.title, path },
];
const cardPost = toBlogCardPost(article);
const related = getRelatedBlogPostsFull(article.slug, 4);
const relatedCards = getRelatedBlogArticles(article.slug, 3).map(toBlogCardPost);
const published = parseBlogDate(article.date);
const updated = parseBlogDate(article.updated);

const jsonLd: Record<string, unknown>[] = [
  articleSchema({
    name: article.seoTitle,
    headline: article.h1,
    description: article.description,
    url: path,
    image: article.image,
    datePublished: published,
    dateModified: updated,
  }),
  breadcrumbSchema(breadcrumbs),
];

---

<BaseLayout
  title={article.seoTitle}
  description={article.description}
  ogImage={article.image}
  ogImageAlt={article.imageAlt}
  ogType="article"
  articlePublishedTime={published}
  articleModifiedTime={updated}
  jsonLd={jsonLd}
>
  <article class="pb-24 pt-8 md:py-12 lg:pb-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      <BlogPostTopBar post={cardPost} class="mt-4" />

      <div class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,1fr)_17.5rem] lg:items-start">
        <div class="min-w-0 lg:col-start-1">
          <header class="max-w-3xl">
            <h1 class="section-header__title mt-2">{article.h1}</h1>
            <p class="mt-4 text-base leading-relaxed text-muted-foreground">{article.excerpt}</p>
            <p class="mt-2 text-xs text-muted-foreground">
              Published <time datetime={article.date}>{article.date}</time>
              {article.updated !== article.date && (
                <>
                  {' '}
                  · Updated <time datetime={article.updated}>{article.updated}</time>
                </>
              )}
            </p>
            <div class="mt-6">
              <ShareButtons shareUrl={canonicalUrl(path)} shareText={article.seoTitle} />
            </div>
          </header>

          <div class="mt-8 overflow-hidden rounded-xl border border-border">
            <ResponsiveImage
              src={article.image}
              alt={article.imageAlt}
              width={960}
              height={540}
              loading="eager"
              fetchPriority="high"
              class="aspect-video w-full object-cover"
            />
          </div>

          <details class="blog-toc-mobile not-prose mt-6 rounded-xl border border-border bg-card/40 px-4 py-3 lg:hidden">
            <summary class="cursor-pointer text-sm font-semibold">Table of contents</summary>
            <div class="mt-3 border-t border-border pt-3">
              <BlogSidebar post={article} related={[]} />
            </div>
          </details>

          <div class="mt-10 max-w-3xl">
            <BlogArticleBody body={article.body} />
            <BlogFaqSection items={article.faq} />
            <div class="mt-10 flex flex-wrap gap-3">
              <Button as="a" href={ROUTES.blogs} variant="outline" size="sm">
                <Icon name="chevronLeft" size={16} />
                Back to blogs
              </Button>
              <Button as="a" href={ROUTES.products} variant="primary" size="sm">
                Explore products
                <Icon name="arrowRight" size={16} />
              </Button>
            </div>
          </div>
        </div>

        <BlogSidebar post={article} related={related} class="hidden lg:block lg:col-start-2" />
      </div>
    </div>
  </article>

  {
    relatedCards.length > 0 && (
      <section class="border-t border-border bg-muted/15 py-14 md:py-16" aria-labelledby="related-articles-title">
        <div class="mx-auto max-w-6xl px-5">
          <h2 id="related-articles-title" class="font-heading text-2xl font-bold">{t.pages.blog.related}</h2>
          <div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {relatedCards.map((post, index) => (
              <BlogCard post={post} index={index} showDate readLabel={t.pages.blog.readMore} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
