# Production canonical (build fails if workers.dev is set here).
# PUBLIC_SITE_ORIGIN=https://caliber-cheats.org

# Google Analytics (optional)
# PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX

# Organization sameAs profiles (comma-separated URLs)
# PUBLIC_ORG_SAME_AS=https://discord.com/invite/...

# IndexNow (optional — key file must be served at https://caliber-cheats.org/{key}.txt)
# INDEXNOW_KEY=

# Twitter cards (optional)
# PUBLIC_TWITTER_SITE=
# PUBLIC_TWITTER_CREATOR=