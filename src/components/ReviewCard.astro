---
import ReviewStars from './ReviewStars.astro';
import type { CustomerReview } from '../data/customerReviews/types';
import { getProductPage, productHub } from '../data/products';
import { productPath } from '../utils/path';

interface Props {
  review: CustomerReview;
}

const { review } = Astro.props;
const initials = review.displayName
  .split(/\s+/)
  .map((part) => part[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
const dateLabel = new Date(review.createdAt).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
const productHref = review.productSlug
  ? getProductPage(review.productSlug)
    ? productPath(review.productSlug)
    : productHub.path
  : undefined;
---

<article class="reviews-card reviews-card--elevated flex h-full flex-col">
  <div class="flex items-start gap-3">
    <div
      class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-muted/50 text-xs font-bold text-foreground"
      aria-hidden="true"
    >
      {initials}
    </div>
    <div class="min-w-0 flex-1">
      <p class="reviews-card__author">{review.displayName}</p>
      <p class="mt-0.5 text-xs text-muted-foreground">{dateLabel}</p>
    </div>
    <ReviewStars rating={review.rating} variant="gold" class="shrink-0 text-base" />
  </div>

  <div class="reviews-card__meta mt-3 flex flex-wrap items-center gap-2">
    {review.productName && (
      <p class="reviews-card__product m-0">
        {productHref ? (
          <a href={productHref} class="hover:underline">
            {review.productName}
          </a>
        ) : (
          review.productName
        )}
      </p>
    )}
    {review.verifiedPurchase && (
      <span class="rounded-full bg-primary/15 px-2 py-0.5 text-[0.65rem] font-semibold uppercase tracking-wide text-primary">
        Verified purchase
      </span>
    )}
  </div>

  {review.title && <h3 class="mt-3 text-base font-semibold leading-snug text-foreground">{review.title}</h3>}
  <p class="reviews-card__body flex-1">{review.content}</p>
  {typeof review.helpfulCount === 'number' && review.helpfulCount > 0 && (
    <p class="mt-3 text-xs text-muted-foreground">{review.helpfulCount} found this helpful</p>
  )}
</article>
