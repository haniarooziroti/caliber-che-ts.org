---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ReviewsPageList from '../components/ReviewsPageList.astro';
import { resolvePageSeo, canonicalUrl, SITE_ORIGIN } from '../config/seo';
import { breadcrumbSchema } from '../utils/schema';
import {
  computeReviewStats,
  getGenuinePublishedCustomerReviews,
  getReviewsForDisplay,
} from '../data/customerReviews';
import { t } from '../i18n';
import '../styles/reviews-page.css';

const seo = resolvePageSeo('/reviews/');
const breadcrumbs = [
  { name: t.pages.crumbs.home, path: '/' },
  { name: t.pages.reviews.crumb, path: '/reviews/' },
];
const genuine = getGenuinePublishedCustomerReviews();
const displayStats = computeReviewStats(getReviewsForDisplay());

const webPageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: seo.title,
  description: seo.description,
  url: canonicalUrl('/reviews/'),
  isPartOf: {
    '@type': 'WebSite',
    name: 'calibercheat.net',
    url: SITE_ORIGIN,
  },
  ...(displayStats.total > 0 && displayStats.average != null
    ? {
        mainEntity: {
          '@type': 'Product',
          name: 'Caliber Cheats',
          description: 'Caliber PC modules: aimbot, ESP, wallhack, and related utilities.',
          url: canonicalUrl('/products/caliber/'),
          aggregateRating: {
            '@type': 'AggregateRating',
            ratingValue: Number(displayStats.average.toFixed(1)),
            reviewCount: displayStats.total,
            bestRating: 5,
            worstRating: 1,
          },
        },
      }
    : {}),
};

const reviewListLd =
  genuine.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        name: 'Caliber Cheats customer reviews',
        numberOfItems: genuine.length,
        itemListElement: genuine.slice(0, 20).map((review, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          item: {
            '@type': 'Review',
            author: { '@type': 'Person', name: review.displayName },
            datePublished: review.createdAt,
            reviewBody: review.content,
            name: review.title,
            reviewRating: {
              '@type': 'Rating',
              ratingValue: review.rating,
              bestRating: 5,
              worstRating: 1,
            },
          },
        })),
      }
    : null;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  robots="index, follow"
  jsonLd={[breadcrumbSchema(breadcrumbs), webPageLd, ...(reviewListLd ? [reviewListLd] : [])]}
>
  <section class="reviews-page">
    <div class="reviews-page__shell mx-auto max-w-6xl px-5 pt-10 md:pt-12">
      <Breadcrumbs items={breadcrumbs} />
      <header class="reviews-page__header mt-6 max-w-3xl">
        <p class="reviews-page__eyebrow">{t.pages.reviews.eyebrow}</p>
        <h1 class="reviews-page__title">{t.pages.reviews.h1}</h1>
        <p class="reviews-page__lead">{t.pages.reviews.heroDesc}</p>
        {displayStats.total > 0 && (
          <p class="mt-3 text-sm text-muted-foreground">
            {displayStats.total} {displayStats.total === 1 ? 'review' : 'reviews'}
            {displayStats.verifiedCount > 0 ? ` · ${displayStats.verifiedCount} verified` : ''}
          </p>
        )}
      </header>

      <ReviewsPageList />
    </div>
  </section>
</BaseLayout>
